# Example environment variables for local development
# Copy this to .env and fill in real values. Do NOT commit .env

DJANGO_SECRET_KEY=replace-with-your-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/NAME
# For sqlite local dev use: sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Admin account initial values (optional for automated setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
ADMIN_EMAIL=admin@example.com
